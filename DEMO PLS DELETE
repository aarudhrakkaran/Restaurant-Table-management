        function confirmMergeTables() {
            const srcNum = parseInt(document.getElementById('merge-source-select').value);
            const tgtNum = parseInt(document.getElementById('merge-target-select').value);

            if (srcNum === tgtNum) {
                alert("Source and target table cannot be the same!");
                return;
            }

            const srcTbl = appState.tables.find(t => t.table_number === srcNum);
            const tgtTbl = appState.tables.find(t => t.table_number === tgtNum);

            appState.orders.forEach(o => {
                if (o.table_number === srcNum) o.table_number = tgtNum;
            });

            tgtTbl.guests += srcTbl.guests;
            if (tgtTbl.status === 'GREEN') {
                tgtTbl.status = srcTbl.status;
                tgtTbl.seated_at = srcTbl.seated_at;
            }

            srcTbl.status = 'GREEN';
            srcTbl.seated_at = null;
            srcTbl.ordered_at = null;
            srcTbl.guests = 0;

            logSql(`UPDATE orders SET table_number = ${tgtNum} WHERE table_number = ${srcNum};`);
            logSql(`UPDATE tables SET status = 'GREEN', seated_at = NULL WHERE table_number = ${srcNum};`);

            closeModal('modal-combine');
            saveState();
            renderTablesFloorGrid();
        }

