        function recalculateCheckoutBill() {
            const tbl = appState.tables.find(t => t.id === currentTableId);
            const tableOrders = appState.orders.filter(o => o.table_number === tbl.table_number);
            const container = document.getElementById('checkout-itemized-rows');
            container.innerHTML = '';

            let subtotal = 0;
            tableOrders.forEach(o => {
                const dish = appState.menu.find(m => m.item_id === o.item_id);
                if (dish) {
                    const lineVal = dish.price * o.quantity;
                    subtotal += lineVal;
                    container.innerHTML += `
                        <div class="flex justify-between text-slate-300">
                            <span>${o.quantity}x ${dish.name}</span>
                            <span>$${lineVal.toFixed(2)}</span>
                        </div>
                    `;
                }
            });

            const taxRate = parseFloat(document.getElementById('tax-rate-slider').value);
            document.getElementById('tax-slider-label').innerText = `${taxRate.toFixed(1)}%`;

            const discountAmount = (subtotal * selectedDiscountPercent) / 100;
            const taxableSubtotal = subtotal - discountAmount;
            const taxAmount = (taxableSubtotal * taxRate) / 100;
            const tipAmount = (taxableSubtotal * selectedTipPercent) / 100;
            const grandTotal = taxableSubtotal + taxAmount + tipAmount;

            document.getElementById('chk-subtotal').innerText = `$${subtotal.toFixed(2)}`;
            document.getElementById('chk-discount').innerText = `-$${discountAmount.toFixed(2)}`;
            document.getElementById('chk-tax').innerText = `$${taxAmount.toFixed(2)} (${taxRate}%)`;
            document.getElementById('chk-tip').innerText = `$${tipAmount.toFixed(2)}`;
            document.getElementById('chk-grandtotal').innerText = `$${grandTotal.toFixed(2)}`;
        }

        function printThermalReceipt() {
            const tbl = appState.tables.find(t => t.id === currentTableId);
            const tableOrders = appState.orders.filter(o => o.table_number === tbl.table_number);
            const printArea = document.getElementById('printable-receipt-area');

            let itemsHtml = '';
            let subtotal = 0;
            tableOrders.forEach(o => {
                const dish = appState.menu.find(m => m.item_id === o.item_id);
                if (dish) {
                    const lTot = dish.price * o.quantity;
                    subtotal += lTot;
                    itemsHtml += `
                        <tr style="border-bottom: 1px dashed #bbb;">
                            <td style="padding: 4px 0;">${o.quantity}x ${dish.name}</td>
                            <td style="padding: 4px 0; text-align: right;">$${dish.price.toFixed(2)}</td>
                            <td style="padding: 4px 0; text-align: right;">$${lTot.toFixed(2)}</td>
                        </tr>
                    `;
                }
            });

            const taxRate = document.getElementById('tax-rate-slider').value;
            const grandTotal = document.getElementById('chk-grandtotal').innerText;

            printArea.innerHTML = `
                <div style="font-family: 'Courier New', monospace; max-width: 300px; margin: 0 auto; color: #000;">
                    <div style="text-align: center; border-bottom: 2px solid #000; padding-bottom: 6px; margin-bottom: 10px;">
                        <h2 style="margin: 0; font-size: 16px; font-weight: bold;">AURA BISTRO FINE DINING</h2>
                        <p style="margin: 2px 0; font-size: 10px;">742 Evergreen Terrace, Suite 100</p>
                        <p style="margin: 2px 0; font-size: 10px;">Tel: (555) 019-2831</p>
                    </div>

                    <div style="font-size: 10px; margin-bottom: 8px;">
                        <div><strong>Receipt #:</strong> INV-${Date.now().toString().slice(-6)}</div>
                        <div><strong>Table:</strong> #${tbl.table_number} | <strong>Server:</strong> ${tbl.waiter_name}</div>
                        <div><strong>Date:</strong> ${new Date().toLocaleString()}</div>
                    </div>

                    <table style="width: 100%; font-size: 10px; border-collapse: collapse; margin-bottom: 8px;">
                        <thead>
                            <tr style="border-bottom: 1px solid #000;">
                                <th style="text-align: left;">Item</th>
                                <th style="text-align: right;">Price</th>
                                <th style="text-align: right;">Total</th>
                            </tr>
                        </thead>
                        <tbody>${itemsHtml}</tbody>
                    </table>

                    <div style="font-size: 11px; border-top: 1px solid #000; padding-top: 6px;">
                        <div style="display: flex; justify-content: space-between;"><span>Subtotal:</span><span>$${subtotal.toFixed(2)}</span></div>
                        <div style="display: flex; justify-content: space-between;"><span>Sales Tax (${taxRate}%):</span><span>${document.getElementById('chk-tax').innerText}</span></div>
                        <div style="display: flex; justify-content: space-between; font-weight: bold; font-size: 13px; border-top: 2px solid #000; margin-top: 4px; padding-top: 4px;">
                            <span>GRAND TOTAL:</span><span>${grandTotal}</span>
                        </div>
                    </div>

                    <div style="text-align: center; margin-top: 15px; font-size: 9px;">
                        <p>THANK YOU FOR DINING WITH US!</p>
                        <div style="letter-spacing: 2px; font-size: 14px; font-weight: bold;">||| |||| | |||||| ||</div>
                    </div>
                </div>
            `;

            window.print();
        }

        function completeCheckoutPayment() {
            const tbl = appState.tables.find(t => t.id === currentTableId);
            const grandTotal = parseFloat(document.getElementById('chk-grandtotal').innerText.replace('$', '')) || 0;

            const txId = appState.transactions.length ? Math.max(...appState.transactions.map(t => t.id)) + 1 : 1001;
            appState.transactions.push({
                id: txId,
                table_number: tbl.table_number,
                total_amount: grandTotal,
                timestamp: new Date().toISOString()
            });

            logSql(`INSERT INTO transactions (id, table_number, total_amount, timestamp) VALUES (${txId}, ${tbl.table_number}, ${grandTotal}, CURRENT_TIMESTAMP);`);

            // Clear Orders
            appState.orders = appState.orders.filter(o => o.table_number !== tbl.table_number);
            logSql(`DELETE FROM orders WHERE table_number = ${tbl.table_number};`);

            // Reset Table
            tbl.status = 'GREEN';
            tbl.seated_at = null;
            tbl.ordered_at = null;
            tbl.guests = 0;
            logSql(`UPDATE tables SET status = 'GREEN', seated_at = NULL, ordered_at = NULL WHERE id = ${tbl.id};`);

            closeModal('modal-checkout');
            saveState();
            renderTablesFloorGrid();
        }

        function renderDatabaseTable(tableName) {
            document.querySelectorAll('.db-nav-btn').forEach(b => b.className = "db-nav-btn bg-bistro-surface text-slate-300 hover:text-white px-3 py-1.5 rounded-lg font-semibold");
            const activeBtn = document.getElementById(`db-tab-${tableName}`);
            if (activeBtn) activeBtn.className = "db-nav-btn active bg-indigo-600 text-white px-3 py-1.5 rounded-lg font-semibold";

            const container = document.getElementById('db-inspector-container');
            const data = appState[tableName];

            if (!data || data.length === 0) {
                container.innerHTML = `<div class="p-6 text-center text-slate-500 font-mono text-xs">Table '${tableName}' contains no records.</div>`;
                return;
            }

            const keys = Object.keys(data[0]);
            let headHtml = keys.map(k => `<th class="p-2.5 border-b border-bistro-border text-slate-300 font-mono text-[11px]">${k}</th>`).join('');
            let bodyHtml = data.map(row => {
                let cols = keys.map(k => `<td class="p-2.5 border-b border-bistro-border/60 text-slate-400 font-mono text-[11px]">${row[k] === null ? 'NULL' : escapeHtml(row[k])}</td>`).join('');
                return `<tr class="hover:bg-bistro-surface/40">${cols}</tr>`;
            }).join('');

            container.innerHTML = `
                <table class="w-full text-left">
                    <thead class="bg-bistro-surface">${headHtml}</thead>
                    <tbody>${bodyHtml}</tbody>
                </table>
            `;
        }

        function updateHeaderStats() {
            const green = appState.tables.filter(t => t.status === 'GREEN').length;
            const yellow = appState.tables.filter(t => t.status === 'YELLOW').length;
            const red = appState.tables.filter(t => t.status === 'RED').length;

            document.getElementById('stat-green-count').innerText = green;
            document.getElementById('stat-yellow-count').innerText = yellow;
            document.getElementById('stat-red-count').innerText = red;

            const occupied = appState.tables.filter(t => t.status !== 'GREEN');
            if (occupied.length > 0) {
                const highest = [...occupied].sort((a, b) => new Date(a.seated_at) - new Date(b.seated_at))[0];
                document.getElementById('stat-fifo-highest').innerText = `T#${highest.table_number} (${formatElapsedTime(highest.seated_at)})`;
            } else {
                document.getElementById('stat-fifo-highest').innerText = 'None';
            }

            const totalRev = appState.transactions.reduce((acc, curr) => acc + curr.total_amount, 0);
            document.getElementById('stat-today-revenue').innerText = `$${totalRev.toFixed(2)}`;
        }

        function escapeHtml(str) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        window.onload = function() {
            renderTablesFloorGrid();
            setInterval(() => {
                renderTablesFloorGrid();
            }, 1000);
            logSql("CREATE TABLE IF NOT EXISTS tables (id INT, table_number INT, zone TEXT, capacity INT, status TEXT);");
            logSql("CREATE TABLE IF NOT EXISTS orders (order_id INT, table_number INT, item_id INT, quantity INT);");
        };
    </script>
</body>
</html>
