                { id: 5, table_number: 5, zone: 'Bar', capacity: 2, status: 'RED', seated_at: new Date(Date.now() - 35 * 60 * 1000).toISOString(), ordered_at: new Date(Date.now() - 25 * 60 * 1000).toISOString(), guests: 2, waiter_name: 'Sophia Martinez' },
                { id: 6, table_number: 6, zone: 'Patio', capacity: 8, status: 'GREEN', seated_at: null, ordered_at: null, guests: 0, waiter_name: 'David Kim' }
            ],
            menu: [
                { item_id: 101, name: 'Truffle Burrata', category: 'Appetizers', price: 16.00, icon: '🧀' },
                { item_id: 102, name: 'Seared Wagyu Bites', category: 'Appetizers', price: 22.00, icon: '🥩' },
                { item_id: 103, name: 'Filet Mignon (8oz)', category: 'Main Course', price: 42.00, icon: '🍖' },
                { item_id: 104, name: 'Pan-Seared Sea Bass', category: 'Main Course', price: 36.00, icon: '🐟' },
                { item_id: 105, name: 'Black Truffle Tagliatelle', category: 'Pizzas & Pastas', price: 28.00, icon: '🍝' },
                { item_id: 106, name: 'Artisan Woodfired Margherita', category: 'Pizzas & Pastas', price: 18.00, icon: '🍕' },
                { item_id: 107, name: 'Grand Marnier Soufflé', category: 'Desserts', price: 14.00, icon: '🍮' },
                { item_id: 108, name: 'Vintage Cabernet Sauvignon Glass', category: 'Beverages', price: 15.00, icon: '🍷' },
                { item_id: 109, name: 'Smoked Bourbon Old Fashioned', category: 'Beverages', price: 17.00, icon: '🥃' }
            ],
            orders: [
                { order_id: 1, table_number: 3, item_id: 103, quantity: 2, status: 'In Kitchen' },
                { order_id: 2, table_number: 3, item_id: 108, quantity: 2, status: 'Served' },
                { order_id: 3, table_number: 5, item_id: 105, quantity: 1, status: 'In Kitchen' },
                { order_id: 4, table_number: 5, item_id: 109, quantity: 2, status: 'Served' }
            ],
            waitlist: [
                { id: 1, name: 'Lord Harrington', party_size: 4, phone: '555-0192', time_added: new Date(Date.now() - 18 * 60 * 1000).toISOString(), notes: 'VIP Customer' },
                { id: 2, name: 'Sarah Jenkins', party_size: 2, phone: '555-0841', time_added: new Date(Date.now() - 10 * 60 * 1000).toISOString(), notes: 'Window Table Request' }
            ],
            transactions: [],
            sqlLogs: []
        };

        let appState = loadState();
        let currentTableId = null;
        let selectedCategory = 'All';
        let activeZoneFilter = 'ALL';
        let selectedDiscountPercent = 0;
        let selectedTipPercent = 18;

        function saveState() {
            localStorage.setItem('aura_bistro_state', JSON.stringify(appState));
        }

        function loadState() {
            const saved = localStorage.getItem('aura_bistro_state');
            if (saved) {
                try { return JSON.parse(saved); } catch(e) { console.error(e); }
            }
            return JSON.parse(JSON.stringify(DEFAULT_STATE));
        }

        function resetDataToDefault() {
            if (confirm("Reset all restaurant floor plan tables, orders, and waitlists?")) {
                localStorage.removeItem('aura_bistro_state');
                appState = JSON.parse(JSON.stringify(DEFAULT_STATE));
                saveState();
                location.reload();
            }
        }

        function logSql(query) {
            const timestamp = new Date().toLocaleTimeString();
            appState.sqlLogs.unshift({ query, timestamp });
            if (appState.sqlLogs.length > 50) appState.sqlLogs.pop();
            
            const logContainer = document.getElementById('sql-console-body');
            const logCounter = document.getElementById('sql-log-counter');
            
            if (logContainer) {
                const line = document.createElement('div');
                line.className = "flex gap-2 items-start hover:bg-slate-900/60 p-0.5 rounded";
                line.innerHTML = `<span class="text-slate-500 font-mono">[${timestamp}]</span> <span class="text-amber-400 font-bold font-mono">SQL&gt;</span> <span class="text-slate-200 font-mono flex-1">${escapeHtml(query)}</span>`;
                logContainer.insertBefore(line, logContainer.firstChild);
            }
            if (logCounter) logCounter.innerText = appState.sqlLogs.length;
            saveState();
        }

        function clearSqlConsole() {
            appState.sqlLogs = [];
            document.getElementById('sql-console-body').innerHTML = '';
            document.getElementById('sql-log-counter').innerText = '0';
        }

        function toggleSqlTerminal() {
            const drawer = document.getElementById('sql-terminal-drawer');
            drawer.classList.toggle('translate-y-full');
        }

        function getElapsedTimeMinutes(isoString) {
            if (!isoString) return 0;
            const diffMs = Date.now() - new Date(isoString).getTime();
            return Math.floor(diffMs / (1000 * 60));
        }

        function formatElapsedTime(isoString) {
            if (!isoString) return '00:00';
            const diffMs = Math.max(0, Date.now() - new Date(isoString).getTime());
            const mins = Math.floor(diffMs / (1000 * 60));
            const secs = Math.floor((diffMs % (1000 * 60)) / 1000);
            return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        function switchTab(tabName) {
            document.querySelectorAll('.nav-tab').forEach(btn => {
                btn.className = "nav-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white flex items-center gap-2 transition-all";
            });
            
            const activeBtn = document.getElementById(`tab-btn-${tabName}`);
            if (activeBtn) activeBtn.className = "nav-tab active px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-2 transition-all bg-amber-500 text-slate-950 font-bold shadow";

            ['floorplan', 'fifo', 'waitlist', 'kitchen', 'database'].forEach(view => {
                document.getElementById(`view-${view}`).classList.add('hidden');
            });

            document.getElementById(`view-${tabName}`).classList.remove('hidden');

            if (tabName === 'fifo') renderFifoPriorityView();
            if (tabName === 'waitlist') renderWaitlistView();
            if (tabName === 'kitchen') renderKitchenTicketsView();
            if (tabName === 'database') renderDatabaseTable('tables');
        }

        function renderTablesFloorGrid() {
            const grid = document.getElementById('tables-floor-grid');
            if (!grid) return;
            grid.innerHTML = '';

            const filteredTables = appState.tables.filter(t => activeZoneFilter === 'ALL' || t.zone === activeZoneFilter);

            filteredTables.forEach(tbl => {
                const activeOrders = appState.orders.filter(o => o.table_number === tbl.table_number);
                let orderSubtotal = 0;
                activeOrders.forEach(o => {
                    const item = appState.menu.find(m => m.item_id === o.item_id);
                    if (item) orderSubtotal += item.price * o.quantity;
                });

                const minutesWaiting = getElapsedTimeMinutes(tbl.seated_at);
                const isUrgent = tbl.status !== 'GREEN' && minutesWaiting >= 15;

                let statusBadge, borderStyle, textGlow;
                if (tbl.status === 'GREEN') {
                    statusBadge = `<span class="bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2.5 py-0.5 rounded-full text-[10px] font-bold">🟢 GREEN (Empty)</span>`;
                    borderStyle = "border-bistro-border hover:border-emerald-500/50";
                    textGlow = "";
                } else if (tbl.status === 'YELLOW') {
                    statusBadge = `<span class="bg-amber-500/20 text-amber-300 border border-amber-500/40 px-2.5 py-0.5 rounded-full text-[10px] font-bold">🟡 YELLOW (Occupied)</span>`;
                    borderStyle = isUrgent ? "urgent-pulse border-amber-500" : "border-amber-500/50";
                    textGlow = "text-amber-400";
                } else { // RED
                    statusBadge = `<span class="bg-rose-500/20 text-rose-300 border border-rose-500/40 px-2.5 py-0.5 rounded-full text-[10px] font-bold">🔴 RED (Ordered)</span>`;
                    borderStyle = isUrgent ? "urgent-pulse border-rose-500" : "border-rose-500/50";
                    textGlow = "text-rose-400";
                }

                const card = document.createElement('div');
                card.className = `glass-panel border ${borderStyle} rounded-2xl p-4 flex flex-col justify-between transition-all duration-200 relative group`;

                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <div class="flex items-center gap-1.5">
                                <span class="font-mono text-xs font-bold bg-bistro-surface px-2 py-0.5 rounded border border-bistro-border text-amber-400">
                                    Table #${tbl.table_number}
                                </span>
                                <span class="text-[10px] text-slate-400 bg-slate-900/60 px-2 py-0.5 rounded border border-bistro-border">${tbl.zone}</span>
                            </div>
                            ${statusBadge}
                        </div>

