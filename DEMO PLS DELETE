<!DOCTYPE html>
<html lang="en" class="h-full bg-[#070b14] text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aura Bistro - Luxury Restaurant Management & FIFO Control</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter, JetBrains Mono, Cormorant Garamond -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                        serif: ['Cormorant Garamond', 'serif'],
                    },
                    colors: {
                        bistro: {
                            bg: '#070b14',
                            surface: '#0f172a',
                            card: '#141e33',
                            border: '#1e2d4a',
                            gold: '#f59e0b',
                            goldDark: '#b45309',
                            emerald: '#10b981',
                            amber: '#f59e0b',
                            crimson: '#ef4444'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: rgba(7, 11, 20, 0.8); }
        ::-webkit-scrollbar-thumb { background: rgba(30, 45, 74, 0.9); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(245, 158, 11, 0.6); }

        .glass-panel {
            background: linear-gradient(135deg, rgba(20, 30, 51, 0.7) 0%, rgba(15, 23, 42, 0.85) 100%);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .gold-gradient-text {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .urgent-pulse {
            animation: urgentPulse 1.8s infinite;
        }
        @keyframes urgentPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); border-color: rgba(239, 68, 68, 0.8); }
            50% { box-shadow: 0 0 15px 4px rgba(239, 68, 68, 0.6); border-color: rgba(239, 68, 68, 1); }
        }

        @media print {
            body * { visibility: hidden; }
            #printable-receipt-area, #printable-receipt-area * { visibility: visible; }
            #printable-receipt-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                background: #ffffff !important;
                color: #000000 !important;
                padding: 15px;
            }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="h-full flex flex-col font-sans bg-bistro-bg text-slate-100 selection:bg-amber-500 selection:text-slate-950 antialiased overflow-hidden">

    <header class="bg-bistro-surface/90 border-b border-bistro-border px-4 lg:px-6 py-3 flex items-center justify-between backdrop-blur-md z-30 shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-600 via-amber-500 to-amber-300 flex items-center justify-center text-slate-950 font-bold shadow-lg shadow-amber-500/20">
                <i class="fa-solid fa-crown text-xl"></i>
            </div>
            <div>
                <h1 class="font-serif font-bold text-xl leading-none tracking-wide text-white flex items-center gap-2">
                    AURA <span class="gold-gradient-text font-sans font-extrabold text-sm uppercase tracking-widest">Bistro</span>
                    <span class="text-[10px] bg-amber-500/10 text-amber-400 border border-amber-500/30 px-2 py-0.5 rounded-full font-mono font-medium">v3.0 FIFO Engine</span>
                </h1>
                <p class="text-[11px] text-slate-400 font-medium">SQL Architecture & Customer Priority Operations</p>
            </div>
        </div>

        <nav class="hidden md:flex items-center gap-1 bg-bistro-bg/80 p-1 rounded-xl border border-bistro-border">
            <button onclick="switchTab('floorplan')" id="tab-btn-floorplan" class="nav-tab active px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-2 transition-all bg-amber-500 text-slate-950 font-bold shadow">
                <i class="fa-solid fa-border-all"></i> Floor Plan
            </button>
            <button onclick="switchTab('fifo')" id="tab-btn-fifo" class="nav-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white flex items-center gap-2 transition-all">
                <i class="fa-solid fa-list-ol text-amber-400"></i> FIFO Priority Center
                <span id="badge-fifo-count" class="bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[10px] px-1.5 py-0.2 rounded-full font-bold">0</span>
            </button>
            <button onclick="switchTab('waitlist')" id="tab-btn-waitlist" class="nav-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white flex items-center gap-2 transition-all">
                <i class="fa-solid fa-user-clock text-indigo-400"></i> Walk-in Waitlist
                <span id="badge-waitlist-count" class="bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-[10px] px-1.5 py-0.2 rounded-full font-bold">0</span>
            </button>
            <button onclick="switchTab('kitchen')" id="tab-btn-kitchen" class="nav-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white flex items-center gap-2 transition-all">
                <i class="fa-solid fa-fire text-rose-400"></i> Kitchen Tickets
                <span id="badge-kitchen-count" class="bg-rose-500/20 text-rose-300 border border-rose-500/30 text-[10px] px-1.5 py-0.2 rounded-full font-bold">0</span>
            </button>
            <button onclick="switchTab('database')" id="tab-btn-database" class="nav-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white flex items-center gap-2 transition-all">
                <i class="fa-solid fa-database text-emerald-400"></i> SQL DB Inspector
            </button>
        </nav>

        <div class="flex items-center gap-2">
            <button onclick="openModal('modal-add-table')" class="bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 transition">
                <i class="fa-solid fa-plus"></i> Add Table
            </button>
            <button onclick="toggleSqlTerminal()" class="bg-bistro-card hover:bg-slate-800 text-slate-300 border border-bistro-border px-3 py-1.5 rounded-lg text-xs font-mono flex items-center gap-2 transition">
                <i class="fa-solid fa-terminal text-amber-400"></i>
                <span class="hidden sm:inline">SQL Log</span>
                <span id="sql-log-counter" class="bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[10px] px-1.5 py-0.2 rounded-full font-bold">0</span>
            </button>
            <button onclick="resetDataToDefault()" class="p-2 text-slate-500 hover:text-rose-400 transition" title="Reset Demo Data">
                <i class="fa-solid fa-rotate-right text-xs"></i>
            </button>
        </div>
    </header>

    <section class="bg-bistro-surface/50 border-b border-bistro-border px-4 lg:px-6 py-2 grid grid-cols-2 md:grid-cols-5 gap-2 text-xs shrink-0">
        <div class="bg-bistro-card/80 border border-bistro-border rounded-lg p-2 flex items-center justify-between">
            <div>
                <span class="text-slate-400 text-[10px] font-semibold block uppercase tracking-wider">Empty Tables</span>
                <span id="stat-green-count" class="text-base font-bold text-emerald-400">0</span>
            </div>
            <i class="fa-solid fa-circle text-emerald-500 text-xs"></i>
        </div>
        <div class="bg-bistro-card/80 border border-bistro-border rounded-lg p-2 flex items-center justify-between">
            <div>
                <span class="text-slate-400 text-[10px] font-semibold block uppercase tracking-wider">Occupied (Waiting)</span>
                <span id="stat-yellow-count" class="text-base font-bold text-amber-400">0</span>
            </div>
            <i class="fa-solid fa-circle text-amber-500 text-xs"></i>
        </div>
        <div class="bg-bistro-card/80 border border-bistro-border rounded-lg p-2 flex items-center justify-between">
            <div>
                <span class="text-slate-400 text-[10px] font-semibold block uppercase tracking-wider">Dining (Ordered)</span>
                <span id="stat-red-count" class="text-base font-bold text-rose-400">0</span>
            </div>
            <i class="fa-solid fa-circle text-rose-500 text-xs"></i>
        </div>
        <div class="bg-bistro-card/80 border border-bistro-border rounded-lg p-2 flex items-center justify-between">
            <div>
                <span class="text-slate-400 text-[10px] font-semibold block uppercase tracking-wider">FIFO High Priority</span>
                <span id="stat-fifo-highest" class="text-xs font-mono font-bold text-amber-400 truncate">None</span>
            </div>
            <i class="fa-solid fa-triangle-exclamation text-amber-400 text-xs"></i>
        </div>
        <div class="bg-bistro-card/80 border border-bistro-border rounded-lg p-2 flex items-center justify-between col-span-2 md:col-span-1">
            <div>
                <span class="text-slate-400 text-[10px] font-semibold block uppercase tracking-wider">Today Total Revenue</span>
                <span id="stat-today-revenue" class="text-base font-bold text-emerald-400">$0.00</span>
            </div>
            <i class="fa-solid fa-chart-line text-emerald-400 text-xs"></i>
        </div>
    </section>

    <main class="flex-1 overflow-y-auto p-4 lg:p-6 relative">

        <!-- ================= VIEW 1: FLOOR PLAN GRID ================= -->
        <div id="view-floorplan" class="space-y-4">
            <!-- Filter & Action Tools -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 bg-bistro-card/60 p-3 rounded-xl border border-bistro-border">
                <div class="flex items-center gap-1.5 flex-wrap text-xs">
                    <span class="text-slate-400 font-semibold mr-1"><i class="fa-solid fa-filter"></i> Zone:</span>
                    <button onclick="filterTablesByZone('ALL')" class="zone-btn active px-3 py-1 rounded-lg border border-amber-500 bg-amber-500/20 text-amber-300 font-bold">All Zones</button>
                    <button onclick="filterTablesByZone('Main Dining')" class="zone-btn px-3 py-1 rounded-lg border border-bistro-border bg-bistro-surface text-slate-300 hover:text-white">Main Dining</button>
                    <button onclick="filterTablesByZone('Patio')" class="zone-btn px-3 py-1 rounded-lg border border-bistro-border bg-bistro-surface text-slate-300 hover:text-white">Patio</button>
                    <button onclick="filterTablesByZone('VIP Lounge')" class="zone-btn px-3 py-1 rounded-lg border border-bistro-border bg-bistro-surface text-slate-300 hover:text-white">VIP Lounge</button>
                    <button onclick="filterTablesByZone('Bar')" class="zone-btn px-3 py-1 rounded-lg border border-bistro-border bg-bistro-surface text-slate-300 hover:text-white">Bar</button>
                </div>

                <div class="flex items-center gap-2">
                    <button onclick="openCombineModal()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-link"></i> Merge Tables
                    </button>
                </div>
            </div>

            <div id="tables-floor-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Tables rendered dynamically -->
            </div>
        </div>

        <!-- ================= VIEW 2: FIFO PRIORITY CENTER ================= -->
        <div id="view-fifo" class="hidden space-y-4">
            <div class="bg-bistro-card border border-bistro-border rounded-xl p-5 shadow-2xl">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 border-b border-bistro-border pb-4 mb-4">
                    <div>
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-list-ol text-amber-400"></i> First-In, First-Out (FIFO) Service Priority Engine
                        </h2>
                        <p class="text-xs text-slate-400">Strict chronological queue ranking tables by waiting time to prevent customer delay.</p>
                    </div>
                    <span class="text-xs font-mono bg-amber-500/10 text-amber-300 border border-amber-500/30 px-3 py-1 rounded-lg">
                        <i class="fa-solid fa-shield-halved"></i> Auto-Sorted by `seated_at` & `ordered_at`
                    </span>
                </div>

                <!-- FIFO Ranked List Table -->
                <div class="overflow-x-auto rounded-xl border border-bistro-border">
                    <table class="w-full text-xs text-left">
                        <thead class="bg-bistro-surface font-semibold text-slate-300 border-b border-bistro-border">
                            <tr>
                                <th class="p-3">Rank</th>
                                <th class="p-3">Table & Zone</th>
                                <th class="p-3">Status</th>
                                <th class="p-3">Seated Time</th>
                                <th class="p-3">Elapsed Wait</th>
                                <th class="p-3">Current Active Orders</th>
                                <th class="p-3 text-right">FIFO Action</th>
                            </tr>
                        </thead>
                        <tbody id="fifo-priority-tbody" class="divide-y divide-bistro-border font-mono">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ================= VIEW 3: WALK-IN WAITLIST ================= -->
        <div id="view-waitlist" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Left: Add Party Form -->
            <div class="lg:col-span-4 bg-bistro-card border border-bistro-border rounded-xl p-5 space-y-4 shadow-2xl">
                <h3 class="text-base font-bold text-white flex items-center gap-2 border-b border-bistro-border pb-3">
                    <i class="fa-solid fa-user-plus text-indigo-400"></i> Add Walk-in Guest to Queue
                </h3>

                <form id="waitlist-form" onsubmit="addWalkinGuest(event)" class="space-y-3 text-xs">
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Guest / Party Name</label>
                        <input type="text" id="wl-name" required placeholder="e.g. Alexander Wright" class="w-full bg-bistro-bg border border-bistro-border rounded-lg py-2 px-3 text-white focus:outline-none focus:border-indigo-500">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-slate-300 font-semibold mb-1">Party Size</label>
                            <input type="number" id="wl-size" min="1" max="20" value="2" required class="w-full bg-bistro-bg border border-bistro-border rounded-lg py-2 px-3 text-white font-bold focus:outline-none focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-slate-300 font-semibold mb-1">Phone Number</label>
                            <input type="tel" id="wl-phone" placeholder="(555) 019-2831" class="w-full bg-bistro-bg border border-bistro-border rounded-lg py-2 px-3 text-white focus:outline-none focus:border-indigo-500">
                        </div>
                    </div>
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Special Notes / Seating Requests</label>
                        <input type="text" id="wl-notes" placeholder="e.g. Window seat or High chair" class="w-full bg-bistro-bg border border-bistro-border rounded-lg py-2 px-3 text-white focus:outline-none focus:border-indigo-500">
                    </div>
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2.5 rounded-xl shadow-lg shadow-indigo-600/20 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-[#10b981] fa-plus"></i> Add Party to Walk-in FIFO Queue
                    </button>
                </form>
            </div>

            <!-- Right: Queue List & Fast Seat Action -->
            <div class="lg:col-span-8 bg-bistro-card border border-bistro-border rounded-xl p-5 space-y-4 shadow-2xl">
                <div class="flex items-center justify-between border-b border-bistro-border pb-3">
                    <div>
                        <h3 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-users-line text-indigo-400"></i> Active Walk-in FIFO Waitlist
                        </h3>
                        <p class="text-xs text-slate-400">Longest waiting parties ranked at top for fair seating allocation.</p>
                    </div>
                    <button onclick="seatNextPartyFIFO()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-3.5 py-2 rounded-xl shadow-lg shadow-emerald-600/20 flex items-center gap-1.5">
                        <i class="fa-solid fa-bolt"></i> Seat Next Party (FIFO)
                    </button>
                </div>

                <div id="waitlist-queue-container" class="space-y-2.5">
                    <!-- Populated dynamically -->
                </div>
            </div>
        </div>

        <!-- ================= VIEW 4: KITCHEN TICKET FEED ================= -->
        <div id="view-kitchen" class="hidden space-y-4">
            <div class="bg-bistro-card border border-bistro-border rounded-xl p-5 shadow-2xl">
                <div class="flex items-center justify-between border-b border-bistro-border pb-3 mb-4">
                    <div>
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-fire text-rose-400"></i> Kitchen Execution Tickets (FIFO Queue)
                        </h2>
                        <p class="text-xs text-slate-400">Order tickets automatically arranged in order of timestamp received.</p>
                    </div>
                </div>

                <div id="kitchen-tickets-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- Dynamic Kitchen Tickets -->
                </div>
            </div>
        </div>

        <!-- ================= VIEW 5: SQL DATABASE INSPECTOR ================= -->
        <div id="view-database" class="hidden space-y-4">
            <div class="bg-bistro-card border border-bistro-border rounded-xl p-5 shadow-2xl">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-bistro-border pb-4 mb-4">
                    <div>
                        <h2 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-database text-emerald-400"></i> Relational SQLite Engine (`restaurant.db`)
                        </h2>
                        <p class="text-xs text-slate-400">Inspect simulated database tables holding operational state.</p>
                    </div>

                    <div class="flex items-center gap-1.5 text-xs">
                        <button onclick="renderDatabaseTable('tables')" id="db-tab-tables" class="db-nav-btn active bg-indigo-600 text-white px-3 py-1.5 rounded-lg font-semibold">`tables`</button>
                        <button onclick="renderDatabaseTable('menu')" id="db-tab-menu" class="db-nav-btn bg-bistro-surface text-slate-300 hover:text-white px-3 py-1.5 rounded-lg font-semibold">`menu`</button>
                        <button onclick="renderDatabaseTable('orders')" id="db-tab-orders" class="db-nav-btn bg-bistro-surface text-slate-300 hover:text-white px-3 py-1.5 rounded-lg font-semibold">`orders`</button>
                        <button onclick="renderDatabaseTable('waitlist')" id="db-tab-waitlist" class="db-nav-btn bg-bistro-surface text-slate-300 hover:text-white px-3 py-1.5 rounded-lg font-semibold">`waitlist`</button>
                        <button onclick="renderDatabaseTable('transactions')" id="db-tab-transactions" class="db-nav-btn bg-bistro-surface text-slate-300 hover:text-white px-3 py-1.5 rounded-lg font-semibold">`transactions`</button>
                    </div>
                </div>

                <div id="db-inspector-container" class="overflow-x-auto rounded-xl border border-bistro-border">
                    <!-- Table output -->
                </div>
            </div>
        </div>

    </main>

    <div id="sql-terminal-drawer" class="fixed bottom-0 left-0 right-0 bg-[#050810] border-t border-bistro-border transition-all duration-300 z-40 flex flex-col h-44 shadow-2xl">
        <div class="bg-bistro-surface px-4 py-2 border-b border-bistro-border flex items-center justify-between text-xs font-mono">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
                <span class="text-amber-400 font-bold">SQL QUERY LOG STREAM</span>
                <span class="text-slate-500">| SQLite3 Connection Active</span>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="clearSqlConsole()" class="text-slate-400 hover:text-white px-2 py-0.5 rounded bg-bistro-card text-[11px]">Clear Console</button>
                <button onclick="toggleSqlTerminal()" class="text-slate-400 hover:text-white p-1"><i class="fa-solid fa-chevron-down"></i></button>
            </div>
        </div>
        <div id="sql-console-body" class="flex-1 p-3 overflow-y-auto font-mono text-[11px] leading-relaxed space-y-1 text-slate-300 bg-[#050810]">
            <!-- SQL Console logs -->
        </div>
    </div>

    <!-- MODAL 1: ADD / EDIT TABLE -->
    <div id="modal-add-table" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-bistro-card border border-bistro-border rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-bistro-border pb-3">
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-chair text-amber-400"></i> <span id="modal-table-title">Add New Table</span>
                </h3>
                <button onclick="closeModal('modal-add-table')" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>

            <form id="add-table-form" onsubmit="saveTableForm(event)" class="space-y-3 text-xs">
                <div>
                    <label class="block text-slate-300 font-semibold mb-1">Table Number</label>
                    <input type="number" id="form-tbl-number" required min="1" max="99" class="w-full bg-bistro-bg border border-bistro-border rounded-xl py-2 px-3 text-white font-bold focus:outline-none focus:border-amber-500" placeholder="e.g. 9">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Seating Capacity</label>
                        <select id="form-tbl-capacity" class="w-full bg-bistro-bg border border-bistro-border rounded-xl py-2 px-3 text-white font-bold focus:outline-none focus:border-amber-500">
                            <option value="2">2 Seats</option>
                            <option value="4" selected>4 Seats</option>
                            <option value="6">6 Seats</option>
                            <option value="8">8 Seats</option>
                            <option value="12">12 Seats (VIP)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Dining Zone</label>
                        <select id="form-tbl-zone" class="w-full bg-bistro-bg border border-bistro-border rounded-xl py-2 px-3 text-white font-bold focus:outline-none focus:border-amber-500">
                            <option value="Main Dining">Main Dining</option>
                            <option value="Patio">Patio</option>
                            <option value="VIP Lounge">VIP Lounge</option>
                            <option value="Bar">Bar</option>
                        </select>
                    </div>
                </div>

