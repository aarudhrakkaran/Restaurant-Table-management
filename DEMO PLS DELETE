        function seatNextPartyFIFO() {
            if (appState.waitlist.length === 0) {
                alert("No parties waiting in walk-in waitlist.");
                return;
            }

            // Oldest waiting party
            const nextParty = [...appState.waitlist].sort((a, b) => new Date(a.time_added) - new Date(b.time_added))[0];

            // Find matching green table
            const availableTable = appState.tables.find(t => t.status === 'GREEN' && t.capacity >= nextParty.party_size);

            if (!availableTable) {
                alert(`No empty table available for party size of ${nextParty.party_size}.`);
                return;
            }

            availableTable.status = 'YELLOW';
            availableTable.seated_at = new Date().toISOString();
            availableTable.guests = nextParty.party_size;

            appState.waitlist = appState.waitlist.filter(w => w.id !== nextParty.id);

            logSql(`UPDATE tables SET status = 'YELLOW', seated_at = CURRENT_TIMESTAMP, guests = ${nextParty.party_size} WHERE id = ${availableTable.id};`);
            logSql(`DELETE FROM waitlist WHERE id = ${nextParty.id};`);

            saveState();
            switchTab('floorplan');
            renderTablesFloorGrid();
        }

